{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "Configuration": "localhost:56338",
    "InstanceName": "aula52:",
    "UseMemoryCache": true
  },
  "Elasticsearch": {
    "Url": "http://localhost:59238/",
    "TimeoutSeconds": 3
  },
  "Cache": {
    "TtlSeconds": 30,
    "PayloadVersion": "v1",
    "FallbackToSourceOnCacheFailure": true,
    "MaxConcurrentSourceFetches": 4,
    "SourceFallbackTimeoutMs": 2000
  }
}
